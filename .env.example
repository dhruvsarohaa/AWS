# Optional live station observations. Both keys are kept on the local/API server.
# Forecasts and Indian city search work without either key.
DATAGOV_API_KEY=
OPENAQ_API_KEY=
OPEN_METEO_API_KEY=
FIRMS_MAP_KEY=
ALERT_SIGNING_KEY=

# R3 integrations start disabled. Signing key must be at least 32 random characters,
# kept server-side in this file or ProviderSecret. No secrets in VITE_* values.
# REVIEW_EMAIL_ENABLED=true
# NOTIFICATION_SENDER=verified-sender@example.org
# WEATHER_ENABLED=true
# FIRES_ENABLED=true
# FIRMS_PRODUCT_VERIFIED=true
# FIRMS_PRODUCT=VIIRS_NOAA20_NRT
# PUBLIC_EVIDENCE_ENABLED=true
# PUBLIC_REDISTRIBUTION_REVIEWED=true
# PUBLIC_EMBED_ORIGINS=https://approved-display.example.org

# Optional, on-demand OpenStreetMap basemap for the bounded pilot (no tile API key).
# Set false to hide map controls. Before broader deployment, choose a tile service
# with appropriate capacity/licensing and update the explicit hosting CSP allowlist.
# VITE_STATION_MAP_ENABLED=false

# Optional local server settings
# API_PORT=3001
# AIRDAY_PORT=5174
# Local station capacity defaults to 20. A bounded pilot may opt into 40.
# Existing evidence/leases are retained; changing this does not certify coverage.
# AIRDAY_MAX_ACTIVE_STATIONS=40

# AWS Amplify frontend builds only: API Gateway base URL without trailing slash
# VITE_API_BASE_URL=https://example.execute-api.ap-south-1.amazonaws.com/prod
# ARCHIVE_OPENAQ=true only after each source's redistribution license is reviewed
